#!/usr/bin/env bash
# next-slot.sh puts this folder first on PATH, so a clippy run a worker types waits for one of the gate's build slots like a gate build does
real=${CARGO_HOME:-${HOME}/.cargo}/bin/cargo-clippy
if [[ ${GATE_BUILD_HELD:-} == 1 || -z ${GATE_BUILD_SLOTS:-} ]]; then
  exec "${real}" "$@"
fi
coordinator=$(git config --get betterlite.coordinator || git rev-parse --path-format=absolute --git-common-dir) || exit 1
folder=${coordinator}/betterlite/builds
mkdir -p -- "${folder}" || exit 1
lowest=${GATE_LOWEST_BUILD_SLOT:-1}
noticed=0
while true; do
  for ((number = lowest; number <= GATE_BUILD_SLOTS; number++)); do
    exec 9>> "${folder}/build-${number}" || exit 1
    if flock -n 9; then
      # the lock stays with this shell, so a sccache server that clippy starts can't inherit it
      GATE_BUILD_HELD=1 "${real}" "$@" 9>&-
      exit
    fi
    exec 9>&-
  done
  if [[ ${noticed} -eq 0 ]]; then
    printf 'gate: waiting for a build slot, slots %s to %s in %s are busy\n' "${lowest}" "${GATE_BUILD_SLOTS}" "${folder}" >&2
    noticed=1
  fi
  sleep 0.1
done
