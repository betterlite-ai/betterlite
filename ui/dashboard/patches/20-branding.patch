diff --git a/ui/litellm-dashboard/src/components/branding/BrandLogo.tsx b/ui/litellm-dashboard/src/components/branding/BrandLogo.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..9de48957f4ebc3c0a756b83c3514a7d1a35cac09
--- /dev/null
+++ b/ui/litellm-dashboard/src/components/branding/BrandLogo.tsx
@@ -0,0 +1,50 @@
+import React, { useState } from "react";
+import { useTheme as useNextTheme } from "next-themes";
+import { BrandWordmark } from "@/components/branding/BrandWordmark";
+import { getProxyBaseUrl } from "@/components/networking";
+import { useTheme } from "@/contexts/ThemeContext";
+import { cn } from "@/lib/cva.config";
+
+interface BrandLogoProps {
+  collapsed?: boolean;
+  imageClassName?: string;
+  // The sidebar passes logo_url_dark first; LiteLLM's navbar ignores it and passes none.
+  darkLogoSrcs?: ReadonlyArray<string | null | undefined>;
+}
+
+const LOGO_CLASS_NAME = "h-5 w-auto max-w-[150px] object-contain";
+
+export const BrandLogo: React.FC<BrandLogoProps> = ({
+  collapsed = false,
+  imageClassName = LOGO_CLASS_NAME,
+  darkLogoSrcs = [],
+}) => {
+  const { logoUrl } = useTheme();
+  const { resolvedTheme } = useNextTheme();
+  const baseUrl = getProxyBaseUrl();
+  const monogram = collapsed ? "&variant=monogram" : "";
+  const lightCandidates = [logoUrl, `${baseUrl}/get_image${collapsed ? "?variant=monogram" : ""}`];
+  const darkCandidates = [...darkLogoSrcs, logoUrl, `${baseUrl}/get_image?theme=dark${monogram}`];
+  const candidates = (resolvedTheme === "dark" ? darkCandidates : lightCandidates).filter((src): src is string =>
+    Boolean(src),
+  );
+  const [loadedSrc, setLoadedSrc] = useState<string | null>(null);
+  const [failedSrcs, setFailedSrcs] = useState<ReadonlyArray<string>>([]);
+  const activeSrc = candidates.find((src) => !failedSrcs.includes(src)) ?? null;
+  const imageReady = activeSrc !== null && loadedSrc === activeSrc;
+
+  return (
+    <span className="flex min-w-0 items-center">
+      {!imageReady && <BrandWordmark collapsed={collapsed} />}
+      {activeSrc !== null && (
+        <img
+          src={activeSrc}
+          alt="betterlite"
+          className={cn(imageClassName, imageReady ? undefined : "hidden")}
+          onLoad={() => setLoadedSrc(activeSrc)}
+          onError={() => setFailedSrcs((previous) => [...previous, activeSrc])}
+        />
+      )}
+    </span>
+  );
+};
