+import React from "react";
+import { cn } from "@/lib/cva.config";
+
+// A logo src that never fetches: Logo renders the text wordmark instead of an <img>.
+export const BRAND_WORDMARK_SRC = "betterlite:wordmark";
+
+interface BrandWordmarkProps {
+  collapsed?: boolean;
+  className?: string;
+}
+
+export const BrandWordmark: React.FC<BrandWordmarkProps> = ({ collapsed = false, className }) => (
+  <span
+    data-brand-wordmark="betterlite"
+    className={cn(
+      "inline-flex select-none items-center font-sans font-semibold tracking-tight text-foreground dark:text-sidebar-foreground",
+      collapsed ? "text-xl leading-none" : "text-lg leading-none",
+      className,
+    )}
+  >
+    {collapsed ? "b" : "betterlite"}
+  </span>
+);
