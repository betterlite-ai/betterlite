from collections.abc import Awaitable

class NativeCache:
    def __init__(self, settings: str) -> None: ...
    def cache_key(self, request: str) -> str: ...
    def async_cache_key(self, request: str) -> Awaitable[str]: ...
    def lookup(self, request: str) -> str: ...
    def async_lookup(self, request: str) -> Awaitable[str]: ...
    def lookup_semantic(self, request: str) -> str: ...
    def async_lookup_semantic(self, request: str) -> Awaitable[str]: ...
    def write(self, request: str) -> None: ...
    def async_write(self, request: str) -> Awaitable[None]: ...
    def write_embedding(self, request: str) -> str: ...
    def async_write_embedding(self, request: str) -> Awaitable[str]: ...
    def write_pipeline(self, request: str) -> None: ...
    def async_write_pipeline(self, request: str) -> Awaitable[None]: ...
    def batch_write(self, request: str) -> None: ...
    def async_batch_write(self, request: str) -> Awaitable[None]: ...
    def close(self) -> None: ...
    def async_close(self) -> Awaitable[None]: ...

def cache_key(settings: str, request: str) -> str: ...
def cache_envelope(settings: str, request: str) -> str: ...
def cache_decode(request: str) -> str: ...
def cache_embedding(settings: str, request: str) -> str: ...
