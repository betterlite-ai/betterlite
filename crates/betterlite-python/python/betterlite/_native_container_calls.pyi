from collections.abc import Awaitable, Sequence

from betterlite._native_completion import NativeError

class NativeContainerError(NativeError): ...

class NativeContainerSession:
    def __init__(self, settings: str) -> None: ...
    def create_container(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def acreate_container(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def list_containers(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def alist_containers(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def retrieve_container(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def aretrieve_container(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def delete_container(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def adelete_container(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
