from collections.abc import Awaitable

class NativeSearchError(Exception): ...

class NativeSearchSession:
    def __init__(self, settings_json: str) -> None: ...
    def search(self, request: str, blobs: list[bytes]) -> str: ...
    def asearch(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def cost(self, request: str, blobs: list[bytes]) -> str: ...
    def ocr(self, request: str, blobs: list[bytes]) -> str: ...
    def aocr(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
