class NativeDual:
    def __init__(
        self, memory: NativeMemory, redis: NativeRedis | None, settings: str
    ) -> None: ...
    def set(self, key: str, value: str, ttl: float | None) -> None: ...
    def async_set(self, key: str, value: str, ttl: float | None) -> Awaitable[None]: ...
    def get(self, key: str) -> str | None: ...
    def async_get(self, key: str) -> Awaitable[str | None]: ...
    def batch_get(
        self, keys: list[str], local_only: bool
    ) -> list[str | None] | None: ...
    def async_batch_get(
        self, keys: list[str], local_only: bool, throttle_redis: bool
    ) -> Awaitable[list[str | None] | None]: ...
    @staticmethod
    def async_batch_get_shared(
        reads: list[tuple[NativeDual, list[str]]]
    ) -> Awaitable[list[list[str | None] | None]]: ...
    def declare_batch_get(self, keys: list[str]) -> NativeDeclaredBatchRead | None: ...
    def increment(self, key: str, value: float, ttl: float | None) -> str: ...
    def async_increment(self, key: str, value: float, ttl: float | None) -> Awaitable[str]: ...
    def delete(self, keys: list[str]) -> None: ...
    def async_delete(self, keys: list[str]) -> Awaitable[None]: ...
    def ttl(self, key: str) -> str | None: ...
    def async_ttl(self, key: str) -> Awaitable[str | None]: ...
    def flush(self) -> None: ...
    def async_flush(self) -> Awaitable[None]: ...
    def ping(self) -> bool: ...
    def async_ping(self) -> Awaitable[bool]: ...
    def close(self) -> None: ...
    def async_close(self) -> Awaitable[None]: ...
    def set_cache_pre_call(
        self, key: str, value: str, ttl: float | None
    ) -> NativeDeferred | None: ...
    def delete_cache_pre_call(self, key: str) -> NativeDeferred | None: ...

class NativeDeferred:
    def async_wait(self) -> Awaitable[None]: ...
    def cancel(self) -> None: ...

class NativeDeclaredBatchRead:
    def async_resolve(self) -> Awaitable[list[str | None]]: ...
