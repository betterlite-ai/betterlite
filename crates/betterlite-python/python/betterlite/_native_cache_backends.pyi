from collections.abc import Awaitable

class NativeMemory:
    def __init__(self, settings: str) -> None: ...
    def set(self, key: str, value: str, ttl: float | None) -> None: ...
    def async_set(self, key: str, value: str, ttl: float | None) -> Awaitable[None]: ...
    def get(self, key: str) -> str | None: ...
    def async_get(self, key: str) -> Awaitable[str | None]: ...
    def increment(self, key: str, value: float, ttl: float | None) -> str: ...
    def async_increment(self, key: str, value: float, ttl: float | None) -> Awaitable[str]: ...
    def delete(self, keys: list[str]) -> None: ...
    def async_delete(self, keys: list[str]) -> Awaitable[None]: ...
    def ttl(self, key: str) -> str | None: ...
    def async_ttl(self, key: str) -> Awaitable[str | None]: ...
    def flush(self) -> None: ...
    def async_flush(self) -> Awaitable[None]: ...
    def ping(self) -> bool: ...
    def async_ping(self) -> Awaitable[bool]: ...
    def close(self) -> None: ...
    def async_close(self) -> Awaitable[None]: ...

