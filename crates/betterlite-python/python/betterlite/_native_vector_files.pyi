from collections.abc import Awaitable, Sequence

from betterlite._native_completion import NativeError

class NativeVectorFileError(NativeError): ...

class NativeVectorFileSession:
    def __init__(self, settings: str) -> None: ...
    def create(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def list(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def retrieve(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def retrieve_content(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def update(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def delete(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def acreate(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def alist(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def aretrieve(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def aretrieve_content(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def aupdate(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def adelete(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
