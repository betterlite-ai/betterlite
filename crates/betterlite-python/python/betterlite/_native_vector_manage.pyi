import builtins
from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeVectorManageError(NativeError): ...

class NativeVectorManageSession:
    def __init__(self, settings: str) -> None: ...
    def retrieve(self, request: str, blobs: builtins.list[bytes]) -> str: ...
    def list(self, request: str, blobs: builtins.list[bytes]) -> str: ...
    def update(self, request: str, blobs: builtins.list[bytes]) -> str: ...
    def delete(self, request: str, blobs: builtins.list[bytes]) -> str: ...
    def aretrieve(self, request: str, blobs: builtins.list[bytes]) -> Awaitable[str]: ...
    def alist(self, request: str, blobs: builtins.list[bytes]) -> Awaitable[str]: ...
    def aupdate(self, request: str, blobs: builtins.list[bytes]) -> Awaitable[str]: ...
    def adelete(self, request: str, blobs: builtins.list[bytes]) -> Awaitable[str]: ...
