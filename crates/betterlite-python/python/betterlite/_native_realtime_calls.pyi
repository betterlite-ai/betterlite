from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeRealtimeError(NativeError): ...

class NativeRealtimeSession:
    def __init__(self, settings: str) -> None: ...
    def aclient_secret(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def atranscription_session(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def acalls(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
