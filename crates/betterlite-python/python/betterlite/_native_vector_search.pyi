from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeVectorSearchError(NativeError): ...

class NativeVectorSearchSession:
    def __init__(self, settings: str) -> None: ...
    def create(self, request: str, blobs: list[bytes]) -> str: ...
    def search(self, request: str, blobs: list[bytes]) -> str: ...
    def acreate(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def asearch(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
