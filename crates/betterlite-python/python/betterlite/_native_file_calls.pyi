from collections.abc import Awaitable, Sequence

from betterlite._native_completion import NativeError

class NativeFileCallError(NativeError): ...

class NativeFileCallSession:
    def __init__(self, settings: str) -> None: ...
    def create(self, payload: str, blobs: Sequence[bytes]) -> str: ...
    def acreate(self, payload: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def delete(self, payload: str, blobs: Sequence[bytes]) -> str: ...
    def adelete(self, payload: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def retrieve(self, payload: str, blobs: Sequence[bytes]) -> str: ...
    def aretrieve(self, payload: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def list(self, payload: str, blobs: Sequence[bytes]) -> str: ...
    def alist(self, payload: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
