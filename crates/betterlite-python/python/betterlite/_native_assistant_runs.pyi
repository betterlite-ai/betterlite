from collections.abc import Awaitable

class NativeAssistantRunError(Exception): ...

class NativeAssistantStream:
    def next_event(self) -> str | None: ...
    def anext_event(self) -> Awaitable[str | None]: ...
    def close(self) -> None: ...
    def aclose(self) -> Awaitable[None]: ...

class NativeAssistantRunSession:
    def __init__(self, settings: str) -> None: ...
    def add_message(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def a_add_message(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def get_messages(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def aget_messages(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def run_thread(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def arun_thread(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def run_stream(
        self, payload_text: str, blobs: list[bytes], asynchronous: bool
    ) -> NativeAssistantStream: ...
