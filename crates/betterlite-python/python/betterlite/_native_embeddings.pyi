from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeEmbeddingError(NativeError): ...

class NativeEmbeddingSession:
    def __init__(self, settings: str) -> None: ...
    def embedding(self, request: str, blobs: list[bytes]) -> str: ...
    def aembedding(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
