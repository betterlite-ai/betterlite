from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeAudioError(NativeError): ...

class NativeAudioSession:
    def __init__(self, settings: str) -> None: ...
    def transcription(self, payload: str, blobs: list[bytes]) -> str: ...
    def atranscription(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def speech(self, payload: str, blobs: list[bytes]) -> tuple[bytes, str]: ...
    def aspeech(self, payload: str, blobs: list[bytes]) -> Awaitable[tuple[bytes, str]]: ...
