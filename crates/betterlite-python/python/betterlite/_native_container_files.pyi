from collections.abc import Awaitable, Sequence

from betterlite._native_completion import NativeError

class NativeContainerFileError(NativeError): ...

class NativeContainerFileSession:
    def __init__(self, settings: str) -> None: ...
    def call(self, request: str, blobs: Sequence[bytes]) -> str: ...
    def acall(self, request: str, blobs: Sequence[bytes]) -> Awaitable[str]: ...
    def content(self, request: str) -> bytes: ...
    def acontent(self, request: str) -> Awaitable[bytes]: ...
