from collections.abc import Awaitable

class NativeAssistantError(Exception): ...

class NativeAssistantSession:
    def __init__(self, settings: str) -> None: ...
    def get_assistants(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def aget_assistants(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def delete_assistant(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def adelete_assistant(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def create_assistants(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def acreate_assistants(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def create_thread(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def acreate_thread(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def get_thread(self, payload_text: str, blobs: list[bytes]) -> str: ...
    def aget_thread(self, payload_text: str, blobs: list[bytes]) -> Awaitable[str]: ...
