from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeRerankError(NativeError): ...

class NativeRerankSession:
    def __init__(self, settings: str) -> None: ...
    def rerank(self, request: str, blobs: list[bytes]) -> str: ...
    def arerank(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
