from collections.abc import Awaitable as _Awaitable
from collections.abc import Sequence as _Sequence

from betterlite._native_completion import NativeError as _NativeError

class NativeTuningError(_NativeError): ...

class NativeTuningSession:
    def create(self, request: str, blobs: _Sequence[bytes]) -> str: ...
    def acreate(self, request: str, blobs: _Sequence[bytes]) -> _Awaitable[str]: ...
    def retrieve(self, request: str, blobs: _Sequence[bytes]) -> str: ...
    def aretrieve(self, request: str, blobs: _Sequence[bytes]) -> _Awaitable[str]: ...
    def list(self, request: str, blobs: _Sequence[bytes]) -> str: ...
    def alist(self, request: str, blobs: _Sequence[bytes]) -> _Awaitable[str]: ...
    def cancel(self, request: str, blobs: _Sequence[bytes]) -> str: ...
    def acancel(self, request: str, blobs: _Sequence[bytes]) -> _Awaitable[str]: ...
