from collections.abc import Awaitable

class NativeBatchError(Exception): ...

class NativeBatchSession:
    def __init__(self, settings: str) -> None: ...
    def create(self, payload: str, blobs: list[bytes]) -> str: ...
    def retrieve(self, payload: str, blobs: list[bytes]) -> str: ...
    def acreate(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def aretrieve(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
