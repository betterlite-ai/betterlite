from collections.abc import Awaitable

class NativePassthroughError(Exception): ...

class NativePassthroughStream:
    def next_chunk(self) -> bytes | None: ...
    def anext_chunk(self) -> Awaitable[bytes | None]: ...
    def close(self) -> None: ...
    def aclose(self) -> Awaitable[None]: ...

class NativePassthroughSession:
    def __init__(self, settings: str) -> None: ...
    def call(
        self, request: str, blobs: list[bytes]
    ) -> tuple[int, list[tuple[str, str]], bytes | NativePassthroughStream]: ...
    def acall(
        self, request: str, blobs: list[bytes]
    ) -> Awaitable[tuple[int, list[tuple[str, str]], bytes | NativePassthroughStream]]: ...

def merge_query_parameters(
    existing_url: str, request_query_params: str, default_query_params: str | None
) -> str: ...
def forward_headers_from_request(
    request_headers: str, headers: str, forward_headers: bool
) -> str: ...
def encode_bedrock_runtime_modelid_arn(endpoint: str) -> str: ...
def resolve_passthrough_timeout(endpoint_timeout: float | None) -> float: ...
def resolve_sdk_timeout(request: str) -> float: ...
