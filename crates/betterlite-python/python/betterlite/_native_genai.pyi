from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeGenaiError(NativeError): ...

class NativeGenaiStream:
    def next_chunk(self) -> bytes | None: ...
    def anext_chunk(self) -> Awaitable[bytes | None]: ...
    def close(self) -> None: ...
    def aclose(self) -> Awaitable[None]: ...

class NativeGenaiSession:
    def __init__(self, settings: str) -> None: ...
    def generate_content(self, payload: str, blobs: list[bytes]) -> str: ...
    def agenerate_content(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def generate_content_stream(self, payload: str, blobs: list[bytes]) -> NativeGenaiStream: ...
    def agenerate_content_stream(
        self, payload: str, blobs: list[bytes]
    ) -> Awaitable[NativeGenaiStream]: ...
