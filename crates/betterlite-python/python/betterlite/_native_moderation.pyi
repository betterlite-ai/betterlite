from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeTextError(NativeError): ...

class NativeTextSession:
    def __init__(self, settings: str) -> None: ...
    def text_completion(self, request: str, blobs: list[bytes]) -> str: ...
    def atext_completion(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def moderation(self, request: str, blobs: list[bytes]) -> str: ...
    def amoderation(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
