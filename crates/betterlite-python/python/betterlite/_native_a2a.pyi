from collections.abc import Awaitable

class NativeA2aError(Exception): ...

class NativeA2aStream:
    def anext_chunk(self) -> Awaitable[str | None]: ...
    def aclose(self) -> Awaitable[None]: ...

class NativeA2aClient:
    base_url: str
    def agent_card(self) -> str: ...
    def send_message(self, call: str) -> Awaitable[str]: ...
    def send_message_streaming(self, call: str) -> Awaitable[NativeA2aStream]: ...

def create_client(settings: str) -> Awaitable[NativeA2aClient]: ...
def get_agent_card(settings: str) -> Awaitable[str]: ...
def send_message_direct(call: str) -> Awaitable[str]: ...
def send_message_streaming_direct(call: str) -> Awaitable[NativeA2aStream]: ...
def is_localhost_or_internal_url(url: str | None) -> bool: ...
def normalize_agent_card_interfaces(card: str) -> str: ...
def get_agent_card_url(card: str) -> str | None: ...
def set_agent_card_url(card: str, url: str) -> str: ...
def fix_agent_card_url(card: str, base_url: str) -> str: ...
