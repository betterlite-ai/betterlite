from collections.abc import Awaitable, Sequence

from betterlite._native_completion import NativeError

class NativeFileContentError(NativeError): ...

class NativeFileStream:
    is_async: bool
    def next_chunk(self) -> bytes | None: ...
    def anext_chunk(self) -> Awaitable[bytes | None]: ...
    def close(self) -> None: ...
    def aclose(self) -> Awaitable[None]: ...

class NativeFileContentSession:
    def __init__(self, settings: str) -> None: ...
    def content(
        self, payload: str, blobs: Sequence[bytes]
    ) -> tuple[str, list[bytes], NativeFileStream | None]: ...
    def acontent(
        self, payload: str, blobs: Sequence[bytes]
    ) -> Awaitable[tuple[str, list[bytes], NativeFileStream | None]]: ...
