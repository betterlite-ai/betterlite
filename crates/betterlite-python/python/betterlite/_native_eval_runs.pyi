from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeEvalRunError(NativeError): ...

class NativeEvalRunSession:
    def __init__(self, settings: str) -> None: ...
    def create_run(self, request: str, blobs: list[bytes]) -> str: ...
    def acreate_run(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def list_runs(self, request: str, blobs: list[bytes]) -> str: ...
    def alist_runs(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def get_run(self, request: str, blobs: list[bytes]) -> str: ...
    def aget_run(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def cancel_run(self, request: str, blobs: list[bytes]) -> str: ...
    def acancel_run(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def delete_run(self, request: str, blobs: list[bytes]) -> str: ...
    def adelete_run(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
