class NativeGuardrailError(Exception): ...

class NativeGuardrail:
    def __init__(self, settings_json: str, strict_modes: bool) -> None: ...
    def mode(self) -> str: ...
    def update_params(self, litellm_params: str) -> None: ...
    def settings(self) -> str: ...
    def render_violation_message(self, default: str, context: str) -> str: ...
    @staticmethod
    def inject_advisory_message(data: str, message: str) -> tuple[bool, str]: ...
    def should_run_guardrail(self, data: str, event_type: str, suppressed: str) -> bool: ...
    def event_hook_is_event_type(self, event_type: str) -> bool: ...
    def dynamic_request_body_params(self, data: str) -> str: ...

class NativeGuardrailInvocation:
    @staticmethod
    def begin(hook: str, request_data: str, inputs: str | None) -> NativeGuardrailInvocation: ...
    def record_own(self, data: str, record_input: str, context: str) -> tuple[str, str]: ...
    def finish_success(self, data: str, response: str | None, context: str) -> tuple[str, str]: ...

def sanitize_guardrail_response(response: str) -> str: ...
def add_guardrail_record(data: str, record_input: str, context: str) -> tuple[str, str]: ...
def sync_log_target(data: str, target: str) -> str: ...
def summarize_guardrail_response(
    response: str, baseline: str | None, event_type: str | None
) -> str: ...
def messages_for_call_type(call_type: str, data: str | None) -> str | None: ...
