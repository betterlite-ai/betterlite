from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeVideoError(NativeError): ...

class NativeVideoSession:
    def __init__(self, settings: str) -> None: ...
    def generation(self, payload: str, blobs: list[bytes]) -> str: ...
    def ageneration(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def content(self, payload: str, blobs: list[bytes]) -> bytes: ...
    def acontent(self, payload: str, blobs: list[bytes]) -> Awaitable[bytes]: ...
    def remix(self, payload: str, blobs: list[bytes]) -> str: ...
    def aremix(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def list(self, payload: str, blobs: list[bytes]) -> str: ...
    def alist(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def status(self, payload: str, blobs: list[bytes]) -> str: ...
    def astatus(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
