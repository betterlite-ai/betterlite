from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeVideoEditError(NativeError): ...

class NativeVideoEditSession:
    def __init__(self, settings: str) -> None: ...
    def create_character(self, payload: str, blobs: list[bytes]) -> str: ...
    def acreate_character(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def get_character(self, payload: str, blobs: list[bytes]) -> str: ...
    def aget_character(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def edit(self, payload: str, blobs: list[bytes]) -> str: ...
    def aedit(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def extension(self, payload: str, blobs: list[bytes]) -> str: ...
    def aextension(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...

def is_litellm_owned_kwarg(name: str) -> bool: ...
