from collections.abc import Awaitable

class NativeMcpError(Exception): ...

class NativeMcpSession:
    def list_tools_page(self, cursor: str | None = None) -> Awaitable[str]: ...
    def call_tool(self, request: str) -> Awaitable[str]: ...
    def load_tools(
        self, tool_format: str, listing_deadline: float | None = None
    ) -> Awaitable[str]: ...
    def call_openai_tool(self, tool_call: str) -> Awaitable[str]: ...
    def aclose(self) -> Awaitable[None]: ...

class NativeMcpClient:
    def __init__(self, settings: str) -> None: ...
    def list_tools(self, raise_on_error: bool = False) -> Awaitable[str]: ...
    def call_tool(self, request: str) -> Awaitable[str]: ...
    def list_prompts(self, raise_on_error: bool = False) -> Awaitable[str]: ...
    def get_prompt(self, request: str) -> Awaitable[str]: ...
    def list_resources(self, raise_on_error: bool = False) -> Awaitable[str]: ...
    def list_resource_templates(self, raise_on_error: bool = False) -> Awaitable[str]: ...
    def read_resource(self, url: str) -> Awaitable[str]: ...
    def discovery_auth_fingerprint(self) -> Awaitable[str]: ...
    def update_auth_value(self, value: str) -> Awaitable[None]: ...
    def instructions(self) -> str | None: ...
    def open_session(
        self, quiet_on_error: bool = False
    ) -> Awaitable[NativeMcpSession]: ...

def tool_to_openai(tool: str) -> str: ...
def tool_to_responses(tool: str) -> str: ...
def tool_to_anthropic(tool: str) -> str: ...
def normalize_input_schema(schema: str | None) -> str: ...
def tool_call_to_mcp(tool_call: str) -> str: ...
