from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeEvalError(NativeError): ...

class NativeEvalSession:
    def __init__(self, settings: str) -> None: ...
    def create_eval(self, request: str, blobs: list[bytes]) -> str: ...
    def acreate_eval(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def list_evals(self, request: str, blobs: list[bytes]) -> str: ...
    def alist_evals(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def get_eval(self, request: str, blobs: list[bytes]) -> str: ...
    def aget_eval(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def update_eval(self, request: str, blobs: list[bytes]) -> str: ...
    def aupdate_eval(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def delete_eval(self, request: str, blobs: list[bytes]) -> str: ...
    def adelete_eval(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def cancel_eval(self, request: str, blobs: list[bytes]) -> str: ...
    def acancel_eval(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
