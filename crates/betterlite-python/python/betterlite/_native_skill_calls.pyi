from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeSkillError(NativeError): ...

class NativeSkillSession:
    def __init__(self, settings: str) -> None: ...
    def create_skill(self, request: str, blobs: list[bytes]) -> str: ...
    def acreate_skill(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def list_skills(self, request: str, blobs: list[bytes]) -> str: ...
    def alist_skills(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def get_skill(self, request: str, blobs: list[bytes]) -> str: ...
    def aget_skill(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def delete_skill(self, request: str, blobs: list[bytes]) -> str: ...
    def adelete_skill(self, request: str, blobs: list[bytes]) -> Awaitable[str]: ...
