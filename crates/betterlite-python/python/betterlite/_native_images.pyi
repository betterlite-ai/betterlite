from collections.abc import Awaitable

from betterlite._native_completion import NativeError

class NativeImageError(NativeError): ...

class NativeImageSession:
    def __init__(self, settings: str) -> None: ...
    def generate(self, payload: str, blobs: list[bytes]) -> str: ...
    def agenerate(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def variation(self, payload: str, blobs: list[bytes]) -> str: ...
    def avariation(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
    def edit(self, payload: str, blobs: list[bytes]) -> str: ...
    def aedit(self, payload: str, blobs: list[bytes]) -> Awaitable[str]: ...
