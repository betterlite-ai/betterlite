from collections.abc import Awaitable

class NativeError(Exception): ...

class NativeChatStream:
    def next_chunk(self) -> str | None: ...
    def anext_chunk(self) -> Awaitable[str | None]: ...
    def close(self) -> None: ...
    def aclose(self) -> Awaitable[None]: ...

class NativeSession:
    def __init__(self, settings: str) -> None: ...
    def completion(self, request: str) -> str | NativeChatStream: ...
    def acompletion(self, request: str) -> Awaitable[str | NativeChatStream]: ...
    def count_tokens(self, request: str) -> str: ...
    def check_valid_key(self, request: str) -> bool: ...
    def valid_model(self, request: str) -> None: ...
