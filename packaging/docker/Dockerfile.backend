ARG LITELLM_RUNTIME_IMAGE=cgr.dev/chainguard/wolfi-base@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d

FROM rust:1.98.0-bookworm AS builder
WORKDIR /app
COPY Cargo.toml Cargo.lock rust-toolchain.toml /app/
# static pcre2: the Wolfi runtime has no shared libpcre2
COPY .cargo/config.toml /app/.cargo/config.toml
COPY crates/ /app/crates/
COPY tools/ /app/tools/
RUN cargo build --release --locked -p betterlite-backend
COPY packaging/docker/component_entrypoint.sh /app/docker/component_entrypoint.sh
RUN sed -i 's/\r$//' /app/docker/component_entrypoint.sh && chmod +x /app/docker/component_entrypoint.sh

FROM $LITELLM_RUNTIME_IMAGE AS runtime
USER root
RUN for i in 1 2 3; do \
      apk add --no-cache bash openssl tzdata && break; \
      [ $i = 3 ] && { echo "apk add failed after 3 retries" >&2; exit 1; }; \
      sleep 5; \
    done
WORKDIR /app
ENV HOME=/home/nonroot
COPY --from=builder /app/target/release/betterlite-backend /usr/local/bin/betterlite-backend
COPY --from=builder --chown=nonroot:nonroot /app/docker /app/docker
USER nonroot
EXPOSE 4001/tcp
ENTRYPOINT ["/app/docker/component_entrypoint.sh", "betterlite-backend"]
CMD ["--host", "0.0.0.0", "--port", "4001"]
